# media-stack configuration.
# install.sh writes a real .env from your answers; this file documents every setting.
# Never commit .env. Lines starting with # are comments.

# ---- System --------------------------------------------------------------
TZ=Etc/UTC
PUID=1000
PGID=1000
UMASK=002
COMPOSE_PROJECT_NAME=media-stack
# Optional services, comma separated: plex,monitoring,subtitles
COMPOSE_PROFILES=

# ---- Storage -------------------------------------------------------------
# One folder that holds downloads and the libraries. It is mounted as /data in
# every container, which is what lets Radarr and Sonarr hardlink instead of copy.
MEDIA_ROOT=/srv/media
# Sub-folders of MEDIA_ROOT (keep them on the same disk for hardlinks).
DOWNLOADS_DIR=downloads
MOVIES_DIR=movies
TV_DIR=tv
# Optional extra movie libraries by original language, as <language code>=<folder>.
# Example: fr=movies-fr,es=movies-es  (folders live under MEDIA_ROOT; empty = off)
MOVIE_LIBRARIES=
# Where the guard scripts keep state and logs, and where config backups go.
STATE_DIR=./state
LOG_DIR=./logs
BACKUP_DIR=./backups
# Optional: network mounts that must be present before anything runs (comma separated host paths).
MOUNT_PATHS=
# Optional mount canary for mount_guard: a file on the storage that something touches every few minutes.
MOUNT_CANARY_FILE=
# Seconds after which that canary counts as stale (empty = 900).
MOUNT_CANARY_MAX_AGE_S=
# Optional: folders under MEDIA_ROOT the integrity scan must skip (comma separated).
INTEGRITY_EXCLUDE=

# ---- VPN (Gluetun) -------------------------------------------------------
# qBittorrent only ever has network access through this tunnel.
# Provider names and their variables: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PRESHARED_KEY=
# OpenVPN providers use these two instead of the WireGuard keys.
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_COUNTRIES=
# on only when your provider supports port forwarding (improves torrent connectivity).
VPN_PORT_FORWARDING=off
# on = only use VPN servers that can forward a port (some providers need it for port forwarding; empty = off).
PORT_FORWARD_ONLY=
# Your LAN, so the qBittorrent web UI (port 8080) stays reachable from your own network.
# install.sh detects this. Example: 192.0.2.0/24
FIREWALL_OUTBOUND_SUBNETS=
# Test installs only. "off" is never the published default; see docs/SETUP.md.
VPN_MODE=on

# ---- Telegram bot --------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Only these Telegram user ids may use the bot (messages, commands, buttons). Comma separated integers.
ALLOWED_TELEGRAM_USER_IDS=
# Older alias of the same list; leave empty.
ALLOWED_CHAT_IDS=
# Where alerts from the guard scripts go. Empty = the first allowed user id.
NOTIFY_CHAT_ID=
# Secret path for the Radarr/Sonarr -> bot webhooks. install.sh generates it.
WEBHOOK_SECRET=
WEBHOOK_PORT=8090

# ---- Plex (optional) -----------------------------------------------------
# Either point at an existing server (PLEX_URL + PLEX_TOKEN) or run one here with
# COMPOSE_PROFILES=plex, in which case PLEX_URL=http://plex:32400 and PLEX_CLAIM is used on first start.
PLEX_URL=
PLEX_TOKEN=
PLEX_CLAIM=

# ---- App addresses as seen from the host (the published ports) -----------
RADARR_URL=http://localhost:7878
SONARR_URL=http://localhost:8989
PROWLARR_URL=http://localhost:9696
QBIT_URL=http://localhost:8080
JELLYSEERR_URL=http://localhost:5055
BAZARR_URL=http://localhost:6767
UPTIME_KUMA_URL=http://localhost:3001
# API keys. Leave empty: the scripts read them from config/<app>/ themselves.
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
JELLYSEERR_API_KEY=
# qBittorrent web UI login. install.sh sets a random password and stores it here.
QBIT_USERNAME=admin
QBIT_PASSWORD=

# ---- Quality rules -------------------------------------------------------
# Hard size caps. The apps store caps per MINUTE of runtime, so a flat per-episode
# limit has to be converted; see docs/AUTOMATIONS.md ("the per-minute cap trap").
EPISODE_CAP_GB=2.5
TV_SIZE_CAP_MB_PER_MIN=38
MOVIE_SIZE_CAP_MB_PER_MIN=25
# false = once a title is downloaded it is never replaced by a "better" copy.
ALLOW_UPGRADES=false
# Releases in any other language than this (or the title's original language) score -10000.
PREFERRED_LANGUAGE=English
BLOCK_MULTI_AUDIO=true
RENAME_FILES=true
MIN_FREE_SPACE_MB=25000

# ---- Bot schedule and behaviour -----------------------------------------
REPORT_HOUR=9
NEW_RELEASES_HOUR=18
NEW_RELEASES_REGIONS=US,GB,CA,AU
# <language>:<movies per day>:<shows per day>, comma separated
NEW_RELEASES_LANG_CAPS=en:5:3
NEW_RELEASES_SERVICES=all
NEW_RELEASES_DAYS_MOVIES=90
NEW_RELEASES_DAYS_TV=45
FILL_HOUR=7
FILL_SEASONS_PER_DAY=4
DEAD_MINUTES=30
DISK_ALERT_PCT=80
FALLBACK_GRACE_SEC=300

# ---- Guard scripts -------------------------------------------------------
# install.sh installs the cron jobs from scripts/cron.template when true.
GUARDS_ENABLED=true
# The space-saver re-downloads files you already own. Off unless you really want it.
SHRINK_ENABLED=false
# verify_imports: when an imported library file cannot be read but its download copy (same size)
# plays fine, rebuild the library file from that copy. Off by default; the copy uses extra disk space.
VERIFY_IMPORTS_HEAL=false
# true = the on-grab guard in Radarr/Sonarr only logs what it would cancel (configure.py applies it).
ONGRAB_DRYRUN=false
# Optional Uptime Kuma push URLs, one per job (empty = no push). Example name: KUMA_PUSH_REGRAB_GUARD
KUMA_PUSH_REGRAB_GUARD=
KUMA_PUSH_LINK_ORPHANS=
KUMA_PUSH_VPN_WATCHDOG=
KUMA_PUSH_VERIFY_IMPORTS=
KUMA_PUSH_MISSING_SWEEP=
KUMA_PUSH_LIBRARY_GUARD=
KUMA_PUSH_CONFIG_BACKUP=
KUMA_PUSH_INTEGRITY_SCAN=
KUMA_PUSH_SUBTITLE_SWEEP=
KUMA_PUSH_UPDATE_CHECK=
KUMA_PUSH_RESTORE_DRILL=
KUMA_PUSH_DEAD_TORRENT_REAPER=
KUMA_PUSH_MALWARE_GUARD=
KUMA_PUSH_MOUNT_GUARD=
KUMA_PUSH_ARR_HEALTH_GUARD=
KUMA_PUSH_SIZE_CAP_WATCH=
KUMA_PUSH_NAMING_GUARD=
